<Application
    x:Class="MailClient.Setup.SetupApp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 品牌蓝：让强调色按钮 / 勾选框 / 进度条不依赖系统强调色，和应用图标一致 -->
            <Color x:Key="SystemAccentColor">#FF1E7BFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF1A6BE0</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1559BF</Color>
            <Color x:Key="SystemAccentColorDark3">#FF10479D</Color>
            <Color x:Key="SystemAccentColorLight1">#FF4B96FF</Color>
            <Color x:Key="SystemAccentColorLight2">#FF6FAAFF</Color>
            <Color x:Key="SystemAccentColorLight3">#FF94C0FF</Color>

            <LinearGradientBrush x:Key="SetupAccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1E7BFF" Offset="0" />
                <GradientStop Color="#FF2B3FD1" Offset="1" />
            </LinearGradientBrush>

            <!-- 圆角卡片：随主题的浅色 / 深色卡片底色 -->
            <Style x:Key="SetupCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="SetupTitle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display, Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="SetupBody" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="SetupCaption" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
