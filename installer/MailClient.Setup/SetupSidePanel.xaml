<UserControl
    x:Class="MailClient.Setup.SetupSidePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Grid x:Name="Root" Background="{StaticResource SetupAccentGradient}" SizeChanged="OnSizeChanged">
        <Ellipse Width="340" Height="340" Fill="#14FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-150,0,0,-130" />
        <Ellipse Width="210" Height="210" Fill="#10FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-80,0" />

        <StackPanel Margin="30,70,30,0" VerticalAlignment="Top" Spacing="6">
            <Image Source="ms-appx:///Assets/AppIcon.png" Width="88" Height="88" HorizontalAlignment="Left" Margin="0,0,0,14" />
            <TextBlock x:Name="NameText" Text="邮件" FontSize="30" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Microsoft YaHei UI" Foreground="White" />
            <TextBlock x:Name="VersionText" FontSize="13" Foreground="#CCFFFFFF" />
        </StackPanel>

        <StackPanel x:Name="StepsPanel" Margin="30,0,30,40" VerticalAlignment="Bottom" Spacing="16" />
    </Grid>
</UserControl>
