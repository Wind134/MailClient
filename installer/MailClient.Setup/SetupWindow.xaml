<Window
    x:Class="MailClient.Setup.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MailClient.Setup">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <local:SetupSidePanel x:Name="Side" />

        <ContentControl x:Name="Host" Grid.Column="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.ContentTransitions>
                <TransitionCollection>
                    <ContentThemeTransition HorizontalOffset="48" VerticalOffset="0" />
                </TransitionCollection>
            </ContentControl.ContentTransitions>
        </ContentControl>

        <!-- 标题栏拖动区（系统的最小化 / 关闭按钮仍在右上角） -->
        <Grid x:Name="DragRegion" Grid.ColumnSpan="2" Height="40" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
