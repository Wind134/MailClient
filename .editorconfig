root = true

# 基础：UTF-8、CRLF、去尾随空格、文件末尾留一个换行
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,xaml,config,xml}]
indent_size = 2

[*.{json,yml,yaml,md}]
end_of_line = lf
indent_size = 2

[*.cs]
# 允许的写法顺序：优先现代语法，但不去强制重写已有代码
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
dotnet_style_prefer_is_null_expression = true:suggestion
dotnet_style_readonly_field = true:suggestion

# 命名：接口 I 前缀、私有字段 _camelCase、常量 PascalCase
dotnet_naming_rule.interfaces_start_with_i.severity = suggestion
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = begins_with_i

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_style.begins_with_i.required_prefix = I

dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# 选择性关闭与本项目取舍冲突的分析器规则：
# CA2007 —— 库内统一使用 ConfigureAwait(false)，但 UI 层刻意不写，逐处标注成本高于收益
dotnet_diagnostic.CA2007.severity = none
# CA1303 —— 本应用界面全中文，无需把字面量挪进资源文件
dotnet_diagnostic.CA1303.severity = none
# CA1062 —— 公共 API 已用 ArgumentNullException.ThrowIfNull 或可空引用约定覆盖
dotnet_diagnostic.CA1062.severity = none
# CA1812 / CA1859 —— 对内部类的性能/密封建议噪音大，收益不明确
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1859.severity = none

[**/Migrations/*.cs]
# 迁移是追加式历史快照，不按当前风格重排
dotnet_diagnostic.CA1861.severity = none

[tests/**/*.cs]
# xunit 惯例用下划线分词的可读方法名（Foo_Bar_When_Baz），与产品代码命名规则不同
dotnet_diagnostic.CA1707.severity = none
dotnet_naming_rule.private_fields_underscore.severity = none
