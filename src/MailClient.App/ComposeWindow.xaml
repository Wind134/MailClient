<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MailClient_App.ComposeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MailClient_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MailClient.ViewModels"
    Title="新邮件"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="ComposeTitleBar" Title="{x:Bind ViewModel.WindowTitle}" />

        <Grid
            Grid.Row="1"
            Margin="24,8,24,20"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox
                AutomationProperties.Name="发件账号"
                Header="发件账号"
                HorizontalAlignment="Stretch"
                DisplayMemberPath="Display"
                ItemsSource="{x:Bind ViewModel.Accounts}"
                SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=TwoWay}" />

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="收件人"
                    Header="收件人"
                    PlaceholderText="多个地址用分号或逗号分隔"
                    Text="{x:Bind ViewModel.To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <HyperlinkButton
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="ShowCc_Click"
                    Content="抄送 / 密送"
                    Visibility="{x:Bind local:Converters.Invert(ViewModel.ShowCc), Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Row="2" Spacing="12" Visibility="{x:Bind ViewModel.ShowCc, Mode=OneWay}">
                <TextBox
                    AutomationProperties.Name="抄送"
                    Header="抄送"
                    Text="{x:Bind ViewModel.Cc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    AutomationProperties.Name="密送"
                    Header="密送"
                    Text="{x:Bind ViewModel.Bcc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <TextBox
                Grid.Row="3"
                AutomationProperties.Name="主题"
                Header="主题"
                Text="{x:Bind ViewModel.Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="4" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button AutomationProperties.Name="添加附件" Click="AddAttachment_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE723;" />
                            <TextBlock Text="添加附件" />
                        </StackPanel>
                    </Button>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.AttachmentSummary, Mode=OneWay}" />
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Attachments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComposeAttachmentViewModel">
                            <Grid ColumnSpacing="8" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon FontSize="14" Glyph="&#xE723;" />
                                <TextBlock Grid.Column="1" Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind SizeText}" />
                                <HyperlinkButton
                                    Grid.Column="3"
                                    Padding="4,0"
                                    AutomationProperties.Name="移除附件"
                                    Click="RemoveAttachment_Click"
                                    Content="移除"
                                    Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.AttachmentWarning, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind local:Converters.VisibleIfNotEmpty(ViewModel.AttachmentWarning), Mode=OneWay}" />
            </StackPanel>

            <TextBox
                Grid.Row="5"
                MinHeight="160"
                VerticalAlignment="Stretch"
                AcceptsReturn="True"
                AutomationProperties.Name="正文"
                Header="正文"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind ViewModel.Body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <Expander
                x:Name="QuoteExpander"
                Grid.Row="6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="引用的原文"
                Header="引用的原文（发送时会附在正文后面）"
                Visibility="{x:Bind ViewModel.HasQuote}">
                <TextBox
                    MaxHeight="150"
                    AcceptsReturn="True"
                    IsReadOnly="True"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.QuotedPreview}"
                    TextWrapping="Wrap" />
            </Expander>

            <Grid Grid.Row="7" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="1"
                    Click="Discard_Click"
                    Content="丢弃" />
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Content="发送"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
