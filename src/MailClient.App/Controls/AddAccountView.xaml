<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MailClient_App.Controls.AddAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:add="using:MailClient.ViewModels.AddAccount"
    xmlns:local="using:MailClient_App">

    <UserControl.Resources>
        <local:HexBrushConverter x:Key="HexBrush" />
        <DataTemplate x:Key="TileTemplate" x:DataType="add:ProviderTileViewModel">
            <Grid
                Width="232"
                Height="112"
                Padding="14"
                AutomationProperties.Name="{x:Bind Title}"
                ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Background="{x:Bind local:Converters.Brush(BrandHex)}"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind Glyph}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock
                        FontWeight="SemiBold"
                        MaxLines="3"
                        Text="{x:Bind Title}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        MaxLines="2"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Subtitle}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="VerifyItemTemplate" x:DataType="add:VerifyItemViewModel">
            <Grid MinHeight="40" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="24" Height="24" VerticalAlignment="Top">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE91F;"
                        Visibility="{x:Bind IsPending, Mode=OneWay}" />
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind IsRunning, Mode=OneWay}"
                        Visibility="{x:Bind IsRunning, Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind IsSucceeded, Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xE711;"
                        Visibility="{x:Bind IsFailed, Mode=OneWay}" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Title}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind StatusText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideStepTemplate" x:DataType="add:GuideStep">
            <Grid Margin="0,2,0,6" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="22"
                    Height="22"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="11">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind Number}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Text}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Padding="0"
                        Content="{x:Bind LinkText}"
                        NavigateUri="{x:Bind LinkUri}"
                        Visibility="{x:Bind HasLink}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideNoteTemplate" x:DataType="x:String">
            <Grid Margin="0,2,0,2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="•" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="GuideLinkTemplate" x:DataType="add:GuideLink">
            <HyperlinkButton
                Padding="0"
                Content="{x:Bind Text}"
                NavigateUri="{x:Bind Uri}" />
        </DataTemplate>
        <DataTemplate x:Key="ColorTemplate" x:DataType="x:String">
            <Border
                Width="32"
                Height="32"
                Background="{x:Bind Converter={StaticResource HexBrush}}"
                CornerRadius="16" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid MinHeight="460" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题 + 步骤进度  -->
        <StackPanel Spacing="6">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="添加账号" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.StepNumber, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="/ 4 ·" />
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}" />
            </StackPanel>
            <ProgressBar
                Maximum="4"
                Minimum="0"
                Value="{x:Bind ViewModel.StepNumber, Mode=OneWay}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Padding="0,0,12,0">
                <!--  ───── 步骤 1：选择类型 ─────  -->
                <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.IsStepPick, Mode=OneWay}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="请选择要添加的邮箱类型" />
                    <GridView
                        x:Name="TileGrid"
                        IsItemClickEnabled="False"
                        ItemTemplate="{StaticResource TileTemplate}"
                        ItemsSource="{x:Bind ViewModel.Tiles}"
                        SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}"
                        SelectionMode="Single" />
                </StackPanel>

                <!--  ───── 步骤 2：登录 ─────  -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStepCredentials, Mode=OneWay}">

                    <!--  各邮箱的分步设置引导（内置，不依赖外部文档；链接用默认浏览器打开）  -->
                    <Expander
                        x:Name="GuideExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="怎么设置"
                        IsExpanded="{x:Bind ViewModel.GuideExpanded, Mode=OneWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind ViewModel.Guide.Title, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.Guide.Intro, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ItemsControl ItemTemplate="{StaticResource GuideStepTemplate}" ItemsSource="{x:Bind ViewModel.Guide.Steps, Mode=OneWay}" />
                            <ItemsControl
                                ItemTemplate="{StaticResource GuideNoteTemplate}"
                                ItemsSource="{x:Bind ViewModel.Guide.Notes, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Guide.HasNotes, Mode=OneWay}" />
                            <ItemsControl
                                ItemTemplate="{StaticResource GuideLinkTemplate}"
                                ItemsSource="{x:Bind ViewModel.Guide.Links, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.Guide.HasLinks, Mode=OneWay}" />
                        </StackPanel>
                    </Expander>
                    <!--  Gmail / Outlook：OAuth  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOAuth, Mode=OneWay}">
                        <TextBox
                            Header="{x:Bind ViewModel.EmailLabel, Mode=OneWay}"
                            PlaceholderText="name@gmail.com"
                            Text="{x:Bind ViewModel.Email, Mode=TwoWay}"
                            Visibility="{x:Bind ViewModel.IsGmail, Mode=OneWay}" />

                        <InfoBar
                            Title="登录前还差一步：创建你自己的应用凭据"
                            IsClosable="False"
                            IsOpen="{x:Bind ViewModel.NeedsClientId, Mode=OneWay}"
                            Message="这是一次性的免费设置。请展开上方的「怎么设置」，按步骤操作，然后把拿到的 ClientId 粘贴到下面的「ClientId 设置」里。"
                            Severity="Warning" />

                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Header="ClientId 设置"
                            IsExpanded="{x:Bind ViewModel.NeedsClientId, Mode=OneWay}">
                            <StackPanel Spacing="10">
                                <TextBox
                                    Header="ClientId"
                                    PlaceholderText="Google：xxxx.apps.googleusercontent.com；Microsoft：应用程序(客户端) ID"
                                    Text="{x:Bind ViewModel.ClientId, Mode=TwoWay}" />
                                <PasswordBox
                                    Header="客户端密钥 Client secret（Google 桌面应用客户端通常需要填写）"
                                    Password="{x:Bind ViewModel.ClientSecret, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.IsGmail, Mode=OneWay}" />
                                <TextBox
                                    Header="租户（默认 common）"
                                    Text="{x:Bind ViewModel.TenantId, Mode=TwoWay}"
                                    Visibility="{x:Bind ViewModel.IsOutlook, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="这些设置保存在本机 %LocalAppData%\MailClient\settings.json 中。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Button
                            x:Name="GoogleSignInButton"
                            Command="{x:Bind ViewModel.SignInCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsGmail, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                <TextBlock Text="用 Google 登录" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="MicrosoftSignInButton"
                            Command="{x:Bind ViewModel.SignInCommand}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsOutlook, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE774;" />
                                <TextBlock Text="用 Microsoft 登录" />
                            </StackPanel>
                        </Button>

                        <!--  等待浏览器 / 登录窗口  -->
                        <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{x:Bind ViewModel.IsSigningIn, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.CancelOperationCommand}"
                                Content="取消登录" />
                        </Grid>
                    </StackPanel>


                    <StackPanel Spacing="12" Visibility="{x:Bind IsImapForm(ViewModel.IsAuthCodeKind, ViewModel.IsOtherImap), Mode=OneWay}">
                        <TextBox
                            Header="邮箱地址"
                            PlaceholderText="name@example.com"
                            Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />
                        <PasswordBox
                            Header="{x:Bind ViewModel.PasswordLabel, Mode=OneWay}"
                            Password="{x:Bind ViewModel.Password, Mode=TwoWay}" />
                    </StackPanel>

                    <!--  其他 IMAP：自动检测 + 高级设置  -->
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsOtherImap, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                Command="{x:Bind ViewModel.DetectServerCommand}"
                                Content="自动检测服务器设置"
                                IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            <ProgressRing
                                Width="20"
                                Height="20"
                                IsActive="{x:Bind ViewModel.IsDetecting, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsDetecting, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ServerHint, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind local:Converters.VisibleIfNotEmpty(ViewModel.ServerHint), Mode=OneWay}" />

                        <Expander
                            x:Name="AdvancedExpander"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Header="高级设置"
                            IsExpanded="{x:Bind ViewModel.ShowAdvanced, Mode=TwoWay}">
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox
                                    Grid.Row="0"
                                    Grid.ColumnSpan="3"
                                    Header="用户名（留空则使用邮箱地址）"
                                    Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" />

                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Header="IMAP 服务器"
                                    PlaceholderText="imap.example.com"
                                    Text="{x:Bind ViewModel.ImapHost, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Header="端口"
                                    InputScope="Number"
                                    Text="{x:Bind ViewModel.ImapPortText, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Header="安全连接"
                                    SelectedIndex="{x:Bind ViewModel.ImapSecurityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="SSL/TLS" />
                                    <ComboBoxItem Content="STARTTLS" />
                                    <ComboBoxItem Content="无（不加密）" />
                                </ComboBox>

                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Header="SMTP 服务器"
                                    PlaceholderText="smtp.example.com"
                                    Text="{x:Bind ViewModel.SmtpHost, Mode=TwoWay}" />
                                <TextBox
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Header="端口"
                                    InputScope="Number"
                                    Text="{x:Bind ViewModel.SmtpPortText, Mode=TwoWay}" />
                                <ComboBox
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    HorizontalAlignment="Stretch"
                                    Header="安全连接"
                                    SelectedIndex="{x:Bind ViewModel.SmtpSecurityIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="SSL/TLS" />
                                    <ComboBoxItem Content="STARTTLS" />
                                    <ComboBoxItem Content="无（不加密）" />
                                </ComboBox>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </StackPanel>

                <!--  ───── 步骤 3：验证 ─────  -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsStepVerify, Mode=OneWay}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="正在检查能否连接并登录你的邮箱服务器（只验证登录，不会发送邮件）…"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemTemplate="{StaticResource VerifyItemTemplate}" ItemsSource="{x:Bind ViewModel.VerifyItems}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.CancelOperationCommand}"
                            Content="取消验证"
                            Visibility="{x:Bind ViewModel.IsVerifying, Mode=OneWay}" />
                        <Button
                            Command="{x:Bind ViewModel.RetryVerifyCommand}"
                            Content="重试"
                            Visibility="{x:Bind ViewModel.CanRetryVerify, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <!--  ───── 步骤 4：完成 ─────  -->
                <StackPanel Spacing="14" Visibility="{x:Bind ViewModel.IsStepFinish, Mode=OneWay}">
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Message="连接验证通过。给这个账号起个名字，并选一个颜色（可选），然后点「完成」。"
                        Severity="Success" />
                    <TextBox
                        Header="显示名称"
                        PlaceholderText="例如：工作邮箱"
                        Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay}" />
                    <StackPanel Spacing="6">
                        <TextBlock Text="账号颜色（可选）" />
                        <GridView
                            IsItemClickEnabled="False"
                            ItemTemplate="{StaticResource ColorTemplate}"
                            ItemsSource="{x:Bind ViewModel.Colors}"
                            SelectedItem="{x:Bind ViewModel.AccountColor, Mode=TwoWay}"
                            SelectionMode="Single" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="不选则使用默认颜色。" />
                    </StackPanel>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="点「完成」后会在后台同步文件夹和最近的邮件，进度显示在左侧窗格底部。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  消息区  -->
        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasValidationError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationError, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                Title="出错了"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>

        <!--  底部按钮  -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{x:Bind ViewModel.CancelCommand}" Content="取消" />
            <Button
                Grid.Column="2"
                Command="{x:Bind ViewModel.BackCommand}"
                Content="上一步"
                IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}" />
            <Button
                Grid.Column="3"
                MinWidth="96"
                Command="{x:Bind ViewModel.NextCommand}"
                Content="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</UserControl>
